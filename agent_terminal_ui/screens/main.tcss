/* MainScreen Styles — Agent Terminal UI
 *
 * Uses Textual's built-in design tokens exclusively.
 * All colors come from the active theme (default: tokyo-night).
 *
 * Concept: AU-018 (TUI Screen Architecture)
 */

/* ── Layout ── */

MainScreen {
    layout: grid;
    grid-size: 1;
    grid-rows: auto 1fr auto auto auto;
}

/* ── Server Log (hidden by default) ── */

#server-log {
    height: 8;
    dock: top;
    background: $surface;
    border-bottom: solid $primary 30%;
    display: none;
    padding: 0 1;
    color: $text-muted;
}

/* ── Main Content Area ── */

#main-content {
    layout: horizontal;
    height: 1fr;
}

/* ── Conversation ── */

Conversation {
    width: 1fr;
}

.welcome-banner {
    height: auto;
    padding: 1 2;
    color: $text-muted;
}

.info-message {
    height: auto;
    padding: 0 1;
    margin: 0 0 1 0;
    color: $text-muted;
}

.error-message {
    height: auto;
    padding: 0 1;
    margin: 0 0 1 0;
    color: $error;
}

/* ── Sidebar ── */

#sidebar {
    width: 30%;
    min-width: 28;
    max-width: 50;
    border-left: solid $primary 30%;
    background: $surface;
    padding: 1;
}

#sidebar-tabs {
    width: 100%;
    height: 1fr;
    background: $surface;
}

/* ── Workflow Sidebar ── */

WorkflowSidebar {
    background: $surface;
    padding: 1;
}

WorkflowSidebar WorkflowNode {
    background: $surface;
    border: solid $primary 30%;
    padding: 1;
    margin: 0 0 1 0;
    color: $text;
}

WorkflowSidebar WorkflowNode:hover {
    border: solid $primary;
}

WorkflowSidebar WorkflowNode.completed {
    border: solid $success;
    color: $success;
}

WorkflowSidebar WorkflowNode.active {
    border: solid $primary;
    color: $primary;
}

WorkflowSidebar .phase-label {
    color: $primary;
    text-style: bold;
    margin: 1 0 0 0;
}

/* ── Input Area ── */

#prompt-container {
    height: auto;
    dock: bottom;
    background: $surface;
    border-top: solid $primary 30%;
    padding: 0;
    transition: border 200ms in_out_cubic;
}

#prompt-container:focus-within {
    border-top: solid $primary;
}

InputTextArea {
    margin: 0;
    height: auto;
    max-height: 10;
    background: $surface;
    color: $text;
    border: none;
    padding: 1;
    transition: background 200ms in_out_cubic;
}

InputTextArea > .text-area--cursor-line {
    background: $primary 8%;
}

InputTextArea:focus {
    border: none;
    background: $primary 4%;
}

/* ── Status Line ── */

StatusLine {
    dock: bottom;
    height: 1;
    margin: 0;
    padding: 0;
    background: $surface;
    border-top: solid $primary 20%;
}

StatusLine Static {
    padding: 0 1;
}

#status-mode {
    color: $background;
    background: $primary;
    text-style: bold;
    padding: 0 1;
}

#status-model {
    color: $text-muted;
}

#status-tokens {
    color: $text-muted;
}

#status-thinking {
    color: $warning;
}

/* ── Buttons ── */

Button {
    background: $primary;
    color: $text;
    border: none;
    padding: 0 2;
    text-style: bold;
    margin: 0 1;
}

Button:hover {
    background: $primary;
    opacity: 0.8;
}

Button.-error {
    background: $error;
}

Button.-primary {
    background: $success;
}

/* ── Tool Call Blocks ── */

ToolCallBlock {
    margin: 0 1 1 1;
}

/* ── Throbber ── */

Throbber {
    margin: 0 1;
}

/* ── Scrollbar Styling ── */

VerticalScroll {
    scrollbar-background: $surface;
    scrollbar-color: $primary 30%;
    scrollbar-color-hover: $primary 60%;
}
